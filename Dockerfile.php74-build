# syntax=docker/dockerfile:1.7-labs

FROM --platform=$TARGETPLATFORM php:7.4-cli AS env

ARG TARGETPLATFORM
ENV DEBIAN_FRONTEND=noninteractive
ENV RUSTUP_HOME=/usr/local/rustup
ENV CARGO_HOME=/usr/local/cargo
ENV PATH=/usr/local/cargo/bin:${PATH}
ENV RUSTUP_DIST_SERVER=https://rsproxy.cn
ENV RUSTUP_UPDATE_ROOT=https://rsproxy.cn/rustup

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        automake \
        ca-certificates \
        cmake \
        curl \
        libcurl4-openssl-dev \
        libtool \
        pkg-config \
    && rm -rf /var/lib/apt/lists/*

RUN curl https://sh.rustup.rs -sSf | sh -s -- -y --profile minimal --default-toolchain stable

FROM env AS build

WORKDIR /src

COPY Makefile ./
COPY config.m4 ./
COPY Cargo.toml ./
COPY Cargo.lock ./
COPY VERSION ./
COPY ddtrace.sym ./
COPY php_ddtrace.h ./
COPY compile_rust.sh ./
COPY m4 ./m4
COPY ext ./ext
COPY src ./src
COPY components ./components
COPY components-rs ./components-rs
COPY zend_abstract_interface ./zend_abstract_interface
COPY libdatadog ./libdatadog

RUN --mount=type=cache,id=ddtrace-php74-arm64-build,target=/src/tmp/build_extension \
    --mount=type=cache,id=ddtrace-php74-arm64-cargo-registry,target=/usr/local/cargo/registry \
    --mount=type=cache,id=ddtrace-php74-arm64-cargo-git,target=/usr/local/cargo/git \
    bash -lc 'set -euo pipefail; \
      mkdir -p tests/ext tests/opcache tests/C2PHP; \
      if ! make -j2 > /tmp/build.log 2>&1; then \
        tail -n 400 /tmp/build.log; \
        exit 1; \
      fi; \
      file tmp/build_extension/modules/ddtrace.so; \
      php -n \
        -d extension=/src/tmp/build_extension/modules/ddtrace.so \
        -d datadog.trace.sources_path=/src/src \
        -v'

FROM scratch AS export

COPY --from=build /src/tmp/build_extension/modules/ddtrace.so /ddtrace.so
COPY --from=build /src/src /src
COPY --from=build /src/VERSION /VERSION
