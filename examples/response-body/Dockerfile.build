FROM php:8.1.34-fpm@sha256:a3118db1911fdd3b3ac66605122ddc859286688ced86fc860fec6d19cc2d6c55
RUN apt-get update && apt-get install -y --no-install-recommends \
    automake cmake libcurl4-openssl-dev libtool pkg-config git file patchelf \
    python3 python3-msgpack \
    && rm -rf /var/lib/apt/lists/*
# Mount a Rust 1.93.0 toolchain and Cargo cache at these paths for the build.
ENV CARGO_HOME=/opt/cargo RUSTUP_HOME=/opt/rustup PATH=/opt/cargo/bin:$PATH
WORKDIR /work
