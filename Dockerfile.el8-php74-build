# syntax=docker/dockerfile:1.7-labs

FROM --platform=linux/amd64 rockylinux:8 AS env

ENV RUSTUP_HOME=/usr/local/rustup
ENV CARGO_HOME=/usr/local/cargo
ENV PATH=/usr/local/cargo/bin:${PATH}
ENV RUSTUP_DIST_SERVER=https://rsproxy.cn
ENV RUSTUP_UPDATE_ROOT=https://rsproxy.cn/rustup

RUN dnf install -y \
        ca-certificates \
        cmake \
        curl \
        diffutils \
        file \
        findutils \
        gcc \
        gcc-c++ \
        git \
        libtool \
        make \
        openssl-devel \
        pkgconfig \
        redhat-rpm-config \
        tar \
        unzip \
        which \
        xz \
    && dnf install -y epel-release \
    && dnf install -y https://rpms.remirepo.net/enterprise/remi-release-8.rpm \
    && dnf module reset -y php \
    && dnf module enable -y php:remi-7.4 \
    && dnf install -y \
        automake \
        libcurl-devel \
        php-cli \
        php-common \
        php-devel \
        php-json \
        php-mbstring \
        php-opcache \
        php-pear \
        php-process \
        php-xml \
    && dnf clean all

RUN curl https://sh.rustup.rs -sSf | sh -s -- -y --profile minimal --default-toolchain stable

FROM env AS build

WORKDIR /src

COPY Makefile ./
COPY config.m4 ./
COPY Cargo.toml ./
COPY Cargo.lock ./
COPY VERSION ./
COPY ddtrace.sym ./
COPY php_ddtrace.h ./
COPY compile_rust.sh ./
COPY m4 ./m4
COPY ext ./ext
COPY src ./src
COPY components ./components
COPY components-rs ./components-rs
COPY zend_abstract_interface ./zend_abstract_interface
COPY libdatadog ./libdatadog

RUN --mount=type=cache,id=ddtrace-el8-php74-build,target=/src/tmp/build_extension \
    --mount=type=cache,id=ddtrace-el8-php74-cargo-registry,target=/usr/local/cargo/registry \
    --mount=type=cache,id=ddtrace-el8-php74-cargo-git,target=/usr/local/cargo/git \
    bash -lc 'set -euo pipefail; \
      find /src/tmp/build_extension -mindepth 1 -maxdepth 1 -exec rm -rf {} + 2>/dev/null || true; \
      mkdir -p tests/ext tests/opcache tests/C2PHP; \
      php -v; \
      phpize -v; \
      php-config --version; \
      if ! make -j2 > /tmp/build.log 2>&1; then \
        tail -n 400 /tmp/build.log; \
        exit 1; \
      fi; \
      file /src/tmp/build_extension/modules/ddtrace.so; \
      php -n \
        -d extension=/src/tmp/build_extension/modules/ddtrace.so \
        -d datadog.trace.sources_path=/src/src \
        -v'

FROM scratch AS export

COPY --from=build /src/tmp/build_extension/modules/ddtrace.so /ddtrace.so
COPY --from=build /src/src /src
COPY --from=build /src/VERSION /VERSION
